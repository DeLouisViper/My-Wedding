rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Hồ sơ người dùng — dùng để tra cứu email khi mời thành viên
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Đám cưới — chỉ thành viên mới được đọc/ghi
    match /weddings/{weddingId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.memberIds;
      allow update: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow delete: if request.auth != null &&
        resource.data.roles[request.auth.uid] == 'owner';

      // Danh sách khách mời / quà cưới
      match /guests/{guestId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/weddings/$(weddingId)).data.memberIds;
        allow create, update, delete: if request.auth != null &&
          get(/databases/$(database)/documents/weddings/$(weddingId)).data.roles[request.auth.uid] in ['owner', 'editor'];
      }
    }
  }
}
